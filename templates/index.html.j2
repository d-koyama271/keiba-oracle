<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="中央競馬の各レースについて、AIが出走馬の過去成績・条件適性・市場オッズなどから1着確率を推定し、購入シミュレーションを掲載します。">
  <title>中央競馬 AI予想レース一覧 | keiba-oracle</title>
  <style>
    :root {
      --status-prediction-bg: {{ status_colors.prediction.background }};
      --status-prediction-color: {{ status_colors.prediction.color }};
      --status-prediction-border: {{ status_colors.prediction.border }};
      --status-result-bg: {{ status_colors.result.background }};
      --status-result-color: {{ status_colors.result.color }};
      --status-result-border: {{ status_colors.result.border }};
      --status-pending-bg: {{ status_colors.pending.background }};
      --status-pending-color: {{ status_colors.pending.color }};
      --status-pending-border: {{ status_colors.pending.border }};
    }
    body {
      margin: 0;
      font-family: "Yu Gothic", "Hiragino Sans", sans-serif;
      background: {{ site_background }};
      color: #1f2520;
    }
    main {
      max-width: 980px;
      margin: 0 auto;
      padding: 32px 20px 56px;
      box-sizing: border-box;
      min-width: 0;
    }
    .panel {
      background: rgba(255, 253, 248, 0.96);
      border: 1px solid #d4cabd;
      border-radius: 14px;
      padding: 20px;
      box-shadow: 0 12px 30px rgba(50, 89, 77, 0.06);
      min-width: 0;
    }
    .panel + .panel { margin-top: 20px; }
    .performance-panel h2 { margin-top: 0; }
    .performance-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
    .profit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 16px;
    }
    .performance-item {
      min-width: 0;
      padding: 14px;
      border: 1px solid #ded6ca;
      border-radius: 10px;
      background: #faf8f3;
    }
    .performance-value {
      margin-top: 8px;
      font-size: 24px;
      font-weight: 700;
    }
    .performance-breakdown {
      display: grid;
      gap: 6px;
      margin-top: 8px;
      line-height: 1.5;
    }
    .profit-line-main {
      display: flex;
      flex-wrap: wrap;
      gap: 0 0.4em;
    }
    .profit-meta { margin-top: 2px; }
    .profit-amount { font-weight: 700; }
    .profit-positive { color: #2f6b63; }
    .profit-negative { color: #9b352b; }
    .profit-neutral { color: inherit; }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    .table-scroll {
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
    }
    .index-table { table-layout: auto; }
    .index-table th,
    .index-table td { padding: 10px 6px; }
    .index-table tbody tr:nth-child(even) { background: #faf6ee; }
    .status-column { text-align: center; }
    .nowrap {
      white-space: nowrap;
      word-break: keep-all;
    }
    th, td {
      text-align: left;
      padding: 12px 8px;
      border-bottom: 1px solid #d4cabd;
    }
    th {
      color: #6f766c;
    }
    a {
      color: #32594d;
      text-decoration: none;
    }
    .page-link {
      color: #32594d;
      text-decoration: underline;
      text-underline-offset: 2px;
      white-space: nowrap;
    }
    .result-link-column { text-align: center; }
    .new-badge {
      display: inline-block;
      margin-left: 5px;
      padding: 1px 5px;
      border: 1px solid #d9c7a3;
      border-radius: 999px;
      background: #fff7df;
      color: #7a5b22;
      font-size: 10px;
      font-weight: 700;
      line-height: 1.4;
      vertical-align: middle;
      white-space: nowrap;
    }
    .status {
      display: inline-block;
      padding: 4px 10px;
      border: 1px solid transparent;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
      white-space: nowrap;
    }
    .status-cancelled { background: #f8e3e3; color: #942f2f; border-color: #dbaaaa; }
    .status-prediction {
      background: var(--status-prediction-bg);
      color: var(--status-prediction-color);
      border-color: var(--status-prediction-border);
    }
    .status-result {
      background: var(--status-result-bg);
      color: var(--status-result-color);
      border-color: var(--status-result-border);
    }
    .status-pending {
      background: var(--status-pending-bg);
      color: var(--status-pending-color);
      border-color: var(--status-pending-border);
    }
    .small {
      color: #6f766c;
      font-size: 14px;
      line-height: 1.7;
    }
    .next-update { font-size: 12px; }
    @media (max-width: 640px) {
      main { padding: 20px 12px 40px; }
      .panel { padding: 15px; }
      .performance-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .profit-grid { grid-template-columns: 1fr; }
      table { font-size: 13px; }
      th, td { padding: 8px 7px; }
      .index-panel {
        padding-right: 12px;
        padding-left: 12px;
      }
      .index-panel .table-scroll { overflow-x: visible; }
      .index-table {
        width: 100%;
        font-size: 13px;
      }
      .index-table thead { display: none; }
      .index-table tbody,
      .index-table tr,
      .index-table td {
        display: block;
      }
      .index-table tbody tr {
        display: grid;
        grid-template-columns: auto auto minmax(0, 1fr) auto auto;
        grid-template-areas:
          "race race race status status"
          "date time track prediction result";
        gap: 7px 8px;
        padding: 10px 4px;
        border-bottom: 1px solid #ddd;
      }
      .index-table td {
        padding: 0;
        border-bottom: 0;
        line-height: 1.4;
      }
      .index-table td:nth-child(1) { grid-area: date; }
      .index-table td:nth-child(2) { grid-area: time; }
      .index-table td:nth-child(3) { grid-area: track; }
      .index-table td:nth-child(4) { grid-area: race; }
      .index-table td:nth-child(5) { grid-area: status; }
      .index-table td:nth-child(6) { grid-area: prediction; }
      .index-table td:nth-child(7) { grid-area: result; }
      .index-table .status {
        font-size: 12px;
      }
      .index-table .race-name-column {
        min-width: 0;
        font-size: 15px;
        font-weight: 700;
        white-space: normal;
        word-break: normal;
      }
      .index-table .status-column {
        justify-self: end;
        text-align: right;
      }
      .index-table .next-update { font-size: 12px; }
      .index-table td[data-label]::before {
        content: attr(data-label) " ";
        color: #666;
      }
      .index-table td[colspan] {
        grid-column: 1 / -1;
        grid-area: auto;
      }
    }
  </style>
</head>
<body>
{% macro profit_line(label, simulation) -%}
{% set simulation_races = simulation.get("simulation_races", 0)|int if simulation else 0 %}
{% set purchase_races = simulation.get("purchase_races", 0)|int if simulation else 0 %}
{% set available = simulation and simulation_races %}
{% set profit = simulation.get("cumulative_profit", 0)|int if available else none %}
{% set overall_roi = simulation.get("overall_roi") if available else none %}
            <div class="profit-line">
              <div class="profit-line-main">
              <span>{{ label }}</span>
              <strong class="profit-amount {% if profit is none or profit == 0 %}profit-neutral{% elif profit > 0 %}profit-positive{% else %}profit-negative{% endif %}">{% if profit is not none %}{% if profit > 0 %}+{% endif %}{{ "{:,}".format(profit) }}円{% else %}-{% endif %}</strong>
              </div>
              <div class="small profit-meta">回収率 {% if overall_roi is not none %}{{ "%.1f"|format(overall_roi * 100) }}%{% else %}-{% endif %} ・ 購入 {{ purchase_races }} / {{ simulation_races }}レース</div>
            </div>
{%- endmacro %}
{% macro performance_panel(title, description, overall, simulation) -%}
{% set evaluated_races = overall.get("evaluated_races", 0) if overall else 0 %}
{% set value_simulation = simulation.get("value") if simulation else none %}
{% set dutching_simulation = simulation.get("dutching") if simulation else none %}
    <section class="panel performance-panel">
      <h2>{{ title }}</h2>
      <p class="small performance-description">{{ description }}</p>
      <div class="performance-grid">
        <div class="performance-item">
          <strong>1位的中率</strong>
          <div class="performance-value">{% if evaluated_races and overall.get("top1_hit_rate") is not none %}{{ "%.1f"|format(overall.top1_hit_rate * 100) }}%{% else %}-{% endif %}</div>
          <div class="small">{% if evaluated_races %}{{ overall.get("top1_hits", 0) }} / {{ evaluated_races }}レース{% else %}評価済みレースなし{% endif %}</div>
        </div>
        <div class="performance-item">
          <strong>勝ち馬の予想3位内率</strong>
          <div class="performance-value">{% if evaluated_races and overall.get("top3_hit_rate") is not none %}{{ "%.1f"|format(overall.top3_hit_rate * 100) }}%{% else %}-{% endif %}</div>
          <div class="small">{% if evaluated_races %}{{ overall.get("top3_hits", 0) }} / {{ evaluated_races }}レース{% else %}評価済みレースなし{% endif %}</div>
        </div>
        <div class="performance-item">
          <strong>勝ち馬の平均予想順位</strong>
          <div class="performance-value">{% if evaluated_races and overall.get("average_winner_predicted_rank") is not none %}{{ "%.1f"|format(overall.average_winner_predicted_rank) }}位{% else %}-{% endif %}</div>
        </div>
      </div>
      <div class="performance-grid profit-grid">
        <div class="performance-item">
          <strong>累計収支（単勝）</strong>
          <div class="performance-breakdown">
{{ profit_line("単勝分配方式", dutching_simulation) }}
{{ profit_line("期待値重視方式", value_simulation) }}
          </div>
        </div>
        <div class="performance-item">
          <strong>累計収支（馬連）</strong>
          <div class="performance-breakdown">
{% set quinella = simulation.get("quinella", {}) if simulation else {} %}
{{ profit_line("馬連分配方式", quinella.get("dutching")) }}
{{ profit_line("期待値重視方式", quinella.get("value")) }}
          </div>
        </div>
      </div>
    </section>
{%- endmacro %}
  <main>
    <div class="panel">
      <h1>中央競馬 AI予想</h1>
      <p class="small">ChatGPTが出走馬の過去成績・条件適性・市場オッズなどを分析し、各馬の1着確率を推定しています。</p>
{% if update_description %}
      <p class="small">{{ update_description }}</p>
{% endif %}
    </div>
{% set method_summaries = evaluation_summary.get("methods", {}) if evaluation_summary else {} %}
{% set general_summary = method_summaries.get("general") %}
{% set statistical_summary = method_summaries.get("statistical") %}
{% set general_overall = general_summary.get("overall") if general_summary else (evaluation_summary.get("overall") if evaluation_summary else none) %}
{% set general_simulation = general_summary.get("simulation") if general_summary else (evaluation_summary.get("simulation") if evaluation_summary else none) %}
{% set statistical_overall = statistical_summary.get("overall") if statistical_summary else none %}
{% set statistical_simulation = statistical_summary.get("simulation") if statistical_summary else none %}
{{ performance_panel("総合AI予想の予測成績", prediction_method_descriptions.get("general", ""), general_overall, general_simulation) }}
{{ performance_panel("統計重視予想の予測成績", prediction_method_descriptions.get("statistical", ""), statistical_overall, statistical_simulation) }}
    <div class="panel index-panel">
      <h2>レース一覧</h2>
      <div class="table-scroll">
      <table class="index-table">
        <thead>
          <tr>
            <th class="nowrap">日付</th>
            <th class="nowrap">発走</th>
            <th class="nowrap">開催場</th>
            <th class="race-name-column">レース名</th>
            <th class="nowrap status-column">状態</th>
            <th class="nowrap">予想</th>
            <th class="nowrap result-link-column">結果</th>
          </tr>
        </thead>
        <tbody>
{% for race in races %}
          <tr>
            <td class="nowrap">{{ race.date }}</td>
            <td class="nowrap">{{ race.start_time or "-" }}</td>
            <td class="nowrap">{{ race.track }}</td>
            <td class="race-name-column">{{ race.race_name|e }}{% if race.is_new %}<span class="new-badge">NEW!</span>{% endif %}</td>
            <td class="nowrap status-column"><span class="status {{ race.status_class }}">{{ race.status_label }}</span>{% if race.next_update %}<div class="small next-update"><time datetime="{{ race.next_update.at }}">{{ race.next_update.label }}</time></div>{% endif %}</td>
            <td class="nowrap" data-label="予想"><a class="page-link" href="{{ race.prediction_href }}">開く</a></td>
            <td class="nowrap result-link-column" data-label="結果">{% if race.result_href %}<a class="page-link" href="{{ race.result_href }}">開く</a>{% else %}-{% endif %}</td>
          </tr>
{% else %}
          <tr>
            <td colspan="7">公開済みレースはまだありません。</td>
          </tr>
{% endfor %}
        </tbody>
      </table>
      </div>
    </div>
    <p class="small">AI予想およびシミュレーション結果は、的中や利益を保証するものではありません。</p>
  </main>
</body>
</html>
