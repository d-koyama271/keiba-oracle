{% macro ticket_tabs(prefix, shared_panel=none) -%}
<div class="ai-method-tabs ticket-tabs" role="tablist" aria-label="シミュレーションの券種">
  <button type="button" class="ai-method-tab" role="tab" data-ticket-tab="win" aria-controls="{{ shared_panel or prefix ~ '-win' }}" aria-selected="true" tabindex="0">単勝</button>
  <button type="button" class="ai-method-tab" role="tab" data-ticket-tab="quinella" aria-controls="{{ shared_panel or prefix ~ '-quinella' }}" aria-selected="false" tabindex="-1">馬連</button>
</div>
{%- endmacro %}

{% macro panels(view, page_kind, rejection_reason_text, explained_term, quinella_tooltips) -%}
{% set q = view.quinella %}
<p class="small">馬連的中確率は各馬の1着確率から算出した、同着を考慮しない近似値です。{% if q.get('harville_lambda') is not none %}λ={{ q.harville_lambda }}{% endif %}</p>
{% if q.get('status') != 'ready' %}
<p class="quinella-unavailable">馬連は計算できません。発走前の完全なオッズ・確率データが記録されていません。</p>
{% else %}
{% for method, label in [('dutching', '馬連分配方式'), ('value', '期待値重視方式')] %}
{% set pre = q[method].pre %}
{% set post = q[method].post %}
<div class="panel {{ 'result-panel' if page_kind == 'result' else 'simulation-panel' }}" data-quinella-method="{{ method }}">
  <h3 class="result-comparison-title"><span>{% if page_kind != 'result' and method == 'dutching' %}{{ explained_term(label, 'dutching_method', quinella_tooltips) }}{% else %}{{ label }}{% if page_kind == 'result' %}のシミュレーション結果{% endif %}{% endif %}</span>{% if page_kind == 'result' and post and post.selections | selectattr('hit', 'sameas', true) | list %}<span class="hit-badge">的中!</span>{% endif %}</h3>
  {% if page_kind == 'result' %}
    {% if post %}
    <div class="metric-grid">
      <div><strong>当初購入額</strong><br>{{ post.total_stake }}円</div>
      <div><strong>返還額</strong><br>{{ post.total_refund }}円</div>
      <div><strong>回収額（返還含む）</strong><br>{{ post.total_return }}円</div>
      <div><strong>損益</strong><br>{{ post.profit }}円</div>
      <div><strong>ROI（損益率）</strong><br>{{ '%.2f'|format(post.roi * 100) }}%</div>
    </div>
    {% if post.selections %}
    <div class="table-scroll"><table class="simulation-table"><thead><tr><th>馬番ペア</th><th>購入額</th><th>判定</th><th>的中払戻</th><th>返還額</th><th>回収額</th></tr></thead><tbody>
      {% for item in post.selections %}<tr><td class="nowrap">{{ item.horse_numbers|join('-') }}</td><td class="nowrap">{{ item.stake }}円</td><td class="nowrap">{{ '返還' if item.refund else ('的中' if item.hit else '不的中') }}</td><td class="nowrap">{{ item.payout }}円</td><td class="nowrap">{{ item.refund }}円</td><td class="nowrap">{{ item.return }}円</td></tr>{% endfor %}
    </tbody></table></div>
    {% else %}<p>購入なし</p>{% endif %}
    {% else %}<p class="quinella-pending">結果・馬連払戻または返還情報の確定待ちです。</p>{% endif %}
  {% elif pre %}
    {% if method == 'dutching' and pre.selections %}
    <div class="dutching-pairs" aria-label="設定条件と計算結果">
      <div class="dutching-pair">
        <div class="dutching-setting"><strong>予算</strong><span class="dutching-setting-value">{{ pre.budget }}円</span></div>
        <div class="dutching-result"><strong>合計購入額</strong><span class="dutching-result-value">{{ pre.total_stake }}円</span></div>
      </div>
      <div class="dutching-pair">
        <div class="dutching-setting"><strong>{{ explained_term('最大対象組数', 'max_selection_count', quinella_tooltips) }}</strong><span class="dutching-setting-value">{{ pre.settings.max_selection_count }}組</span></div>
        <div class="dutching-result"><strong>{{ explained_term('選択組数', 'selection_count', quinella_tooltips) }}</strong><span class="dutching-result-value">{{ pre.selected_count }}組</span></div>
      </div>
      <div class="dutching-pair">
        <div class="dutching-setting"><strong>{{ explained_term('最低カバー確率', 'min_coverage_probability', quinella_tooltips) }}</strong><span class="dutching-setting-value">{{ '%.2f'|format(pre.settings.min_coverage_probability * 100) }}%</span></div>
        <div class="dutching-result"><strong>{{ explained_term('カバー確率', 'coverage_probability', quinella_tooltips) }}</strong><span class="dutching-result-value">{{ '%.2f'|format(pre.coverage_probability * 100) }}%</span></div>
      </div>
      <div class="dutching-pair">
        <div class="dutching-setting"><strong>{{ explained_term('最低グループ期待値', 'min_group_expected_value', quinella_tooltips) }}</strong><span class="dutching-setting-value">{{ '%.3f'|format(pre.settings.min_group_expected_value) }}</span></div>
        <div class="dutching-result"><strong>{{ explained_term('グループ期待値', 'group_expected_value', quinella_tooltips) }}</strong><span class="dutching-result-value">{{ '%.3f'|format(pre.group_expected_value) }}</span></div>
      </div>
      <div class="dutching-pair">
        <div class="dutching-setting"><strong>{{ explained_term('最低利益率', 'min_profit_rate', quinella_tooltips) }}</strong><span class="dutching-setting-value">{{ '%.0f'|format(pre.settings.min_profit_rate * 100) }}%</span></div>
        <div class="dutching-result"><strong>{{ explained_term('最低利益', 'minimum_profit', quinella_tooltips) }}</strong><span class="dutching-result-value">{{ '%.0f'|format(pre.minimum_profit) }}円</span></div>
      </div>
    </div>
    <h4 class="purchase-breakdown-title">購入内訳</h4>
    <div class="table-scroll"><table class="simulation-table purchase-breakdown-table"><thead><tr><th>馬番ペア</th><th>馬連的中確率</th><th>馬連オッズ</th><th>{{ explained_term('EV', 'ev', quinella_tooltips) }}</th><th>購入額</th><th>的中時払戻額</th><th>的中時利益</th></tr></thead><tbody>
      {% for item in pre.selections %}<tr><td class="nowrap">{{ item.horse_numbers|join('-') }}</td><td class="nowrap">{{ '%.2f'|format(item.predicted_probability * 100) }}%</td><td class="nowrap">{{ item.odds }}</td><td class="nowrap">{{ '%.3f'|format(item.expected_value) }}</td><td class="nowrap">{{ item.stake }}円</td><td class="nowrap">{{ '%.0f'|format(item.estimated_payout) }}円</td><td class="nowrap">{{ '%.0f'|format(item.estimated_profit) }}円</td></tr>{% endfor %}
    </tbody></table></div>
    {% else %}
    <h4 class="simulation-block-title">設定条件</h4>
    <div class="metric-grid{% if method == 'dutching' %} simulation-primary-metrics{% endif %}">
      <div><strong>予算</strong><br>{{ pre.budget }}円</div>
      {% if method == 'value' %}
      <div><strong>{{ explained_term('最低EV', 'minimum_ev', quinella_tooltips) }}</strong><br>{{ pre.settings.ev_threshold }}</div>
      <div><strong>{{ explained_term('Kelly係数', 'kelly_fraction', quinella_tooltips) }}</strong><br>{{ pre.settings.kelly_fraction }}</div>
      {% else %}
      <div><strong>{{ explained_term('最大対象組数', 'max_selection_count', quinella_tooltips) }}</strong><br>{{ pre.settings.max_selection_count }}組</div>
      <div><strong>{{ explained_term('最低カバー確率', 'min_coverage_probability', quinella_tooltips) }}</strong><br>{{ '%.2f'|format(pre.settings.min_coverage_probability * 100) }}%</div>
      <div><strong>{{ explained_term('最低グループ期待値', 'min_group_expected_value', quinella_tooltips) }}</strong><br>{{ '%.3f'|format(pre.settings.min_group_expected_value) }}</div>
      <div><strong>{{ explained_term('最低利益率', 'min_profit_rate', quinella_tooltips) }}</strong><br>{{ '%.0f'|format(pre.settings.min_profit_rate * 100) }}%</div>
      {% endif %}
    </div>
    <h4 class="simulation-block-title simulation-result-title">計算結果</h4>
    <div class="metric-grid">
      <div><strong>判定</strong><br>{{ '購入あり' if pre.selections else '購入なし' }}</div>
      <div><strong>合計購入額</strong><br>{{ pre.total_stake }}円</div>
      <div><strong>未使用予算</strong><br>{{ pre.unused_budget }}円</div>
    </div>
    {% endif %}
    {% if method == 'dutching' %}
      <details class="simulation-details"><summary>組数別比較の詳細を見る</summary>
      <div class="table-scroll"><table class="evaluation-table">
        <thead><tr><th>組数</th><th>対象ペア</th><th>{{ explained_term('カバー確率', 'coverage_probability', quinella_tooltips) }}</th><th>{{ explained_term('グループ期待値', 'group_expected_value', quinella_tooltips) }}</th><th>{{ explained_term('最低払戻額', 'minimum_payout', quinella_tooltips) }}</th><th>{{ explained_term('最低利益', 'minimum_profit', quinella_tooltips) }}</th><th>判定</th><th>除外理由</th></tr></thead><tbody>
        {% for item in pre.evaluated_counts %}<tr{% if pre.selections and item.selection_count == pre.selected_count %} class="selected-row"{% endif %}><td>{{ item.selection_count }}</td><td>{% for pair in item.horse_pairs %}{{ pair|join('-') }}{{ ', ' if not loop.last else '' }}{% endfor %}</td><td>{{ '%.2f'|format(item.coverage_probability * 100) }}%</td><td>{{ '%.3f'|format(item.group_expected_value) }}</td><td>{{ '%.0f'|format(item.minimum_payout) }}円</td><td>{{ '%.0f'|format(item.minimum_profit) }}円</td><td>{{ '採用' if pre.selections and item.selection_count == pre.selected_count else ('適格' if item.eligible else '除外') }}</td><td>{{ rejection_reason_text(item.rejection_reasons)|replace('頭数', '組数') }}</td></tr>{% endfor %}
      </tbody></table></div></details>
    {% else %}
      <details class="simulation-details"><summary>全ペア期待値の詳細を見る</summary>
      <div class="table-scroll"><table class="evaluation-table">
        <thead><tr><th>馬番ペア</th><th>馬連的中確率</th><th>馬連オッズ</th><th>{{ explained_term('EV', 'ev', quinella_tooltips) }}</th><th>{{ explained_term('Full Kelly', 'full_kelly', quinella_tooltips) }}</th><th>{{ explained_term('適用Kelly', 'applied_kelly', quinella_tooltips) }}</th><th>{{ explained_term('理論購入額', 'theoretical_stake', quinella_tooltips) }}</th><th>購入額</th></tr></thead><tbody>
        {% for item in pre.details %}<tr><td>{{ item.horse_numbers|join('-') }}</td><td>{{ '%.2f'|format(item.predicted_probability * 100) }}%</td><td>{{ item.odds }}</td><td>{{ '%.3f'|format(item.expected_value) }}</td><td>{{ '%.4f'|format(item.full_kelly * 100) }}%</td><td>{{ '%.4f'|format(item.fractional_kelly * 100) }}%</td><td>{{ '%.2f'|format(item.theoretical_stake) if item.theoretical_stake is not none else '-' }}円</td><td>{{ item.stake }}円</td></tr>{% endfor %}
      </tbody></table></div></details>
      <h4>購入対象</h4>
      {% if pre.selections %}
      <div class="table-scroll"><table class="simulation-table"><thead><tr><th>馬番ペア</th><th>馬連的中確率</th><th>馬連オッズ</th><th>{{ explained_term('EV', 'ev', quinella_tooltips) }}</th><th>購入額</th></tr></thead><tbody>
        {% for item in pre.selections %}<tr><td class="nowrap">{{ item.horse_numbers|join('-') }}</td><td class="nowrap">{{ '%.2f'|format(item.predicted_probability * 100) }}%</td><td class="nowrap">{{ item.odds }}</td><td class="nowrap">{{ '%.3f'|format(item.expected_value) }}</td><td class="nowrap">{{ item.stake }}円</td></tr>{% endfor %}
      </tbody></table></div>
      {% else %}<p><strong>購入なし</strong>：最低EVとKelly基準を満たす購入単位以上の候補がありません。</p>{% endif %}
    {% endif %}
  {% endif %}
</div>
{% endfor %}
{% endif %}
{%- endmacro %}
