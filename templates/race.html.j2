{% extends "base.html.j2" %}
{% import "components/ui.html.j2" as ui %}
{% import "components/tabs.html.j2" as tabs %}
{% import "components/tables.html.j2" as tables %}
{% import "components/simulation.html.j2" as simulation_ui %}
{% from "components/ui.html.j2" import info_tooltip, explained_term, sortable_header with context %}
{% set page_kind = page_kind | default("prediction") %}
{% import 'quinella.html.j2' as quinella_ui %}
{% block title %}{% if page_kind == "result" %}{{ race.race_name|e }} 結果{% else %}{{ race.race_name|e }}{% if "AI予想" not in race.race_name %} AI予想{% endif %}{% endif %} | keiba-oracle{% endblock %}
{% block description %}{% if page_kind == "result" %}{{ race.race_name|e }}のレース結果、AI予想との比較、予測評価、購入シミュレーション結果を掲載します。{% else %}{{ race.race_name|e }}のAI予想。各馬の{{ ui_labels.win_probability }}、予想理由、{{ ui_labels.simulation_method_dutching }}と{{ ui_labels.simulation_method_value }}による購入シミュレーションを掲載します。{% endif %}{% endblock %}
{% block styles %}
    :root {
      color-scheme: light;
      --bg: #f4f1ea;
      --panel: #fffdf8;
      --ink: #1f2520;
      --line: #d5ccbe;
      --accent: #32594d;
      --muted: #6f766c;
    }
    main {
      max-width: 1080px;
      margin: 0 auto;
      padding: 32px 20px 60px;
      box-sizing: border-box;
      min-width: 0;
    }
    .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 20px;
      margin-bottom: 18px;
      box-shadow: 0 10px 30px rgba(50, 89, 77, 0.06);
      min-width: 0;
    }
    h1, h2, h3 { margin-top: 0; }
    .meta, .metric-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 10px;
      font-size: 14px;
    }
    .page-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
    }
    .ai-badge {
      display: inline-block;
      padding: 4px 10px;
      border: 1px solid #c8b9dc;
      border-radius: 999px;
      background: #eee8f6;
      color: #604879;
      font-size: 13px;
      font-weight: 700;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    th, td {
      text-align: left;
      padding: 10px 8px;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
    }
    th {
      color: var(--muted);
      font-weight: 700;
    }
    .prediction-table tbody tr:nth-child(even),
    .result-table tbody tr:nth-child(even) {
      background: #faf6ee;
    }
    table tbody tr.ev-above-threshold {
      background: #f6f3f8;
    }
    .sort-button {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      font-weight: inherit;
      cursor: pointer;
      white-space: nowrap;
    }
    .sort-button:hover,
    .sort-button:focus-visible {
      color: var(--accent);
    }
    .sort-button:focus-visible {
      outline: 2px solid #9bb8ae;
      outline-offset: 2px;
    }
    .sort-indicator {
      font-size: 11px;
      opacity: 0.75;
    }
    table tbody tr.selected-row { background: #fff6dc; }
    .race-meta-spacer { display: none; }
    .small {
      color: var(--muted);
      font-size: 13px;
    }
    .prediction-description {
      font-size: 14px;
      line-height: 1.7;
    }
    a { color: var(--accent); }
    ul {
      margin: 0;
      padding-left: 18px;
    }
    .simulator-form {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
      gap: 12px;
      align-items: end;
      margin: 18px 0;
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: #f8f4ec;
    }
    .simulator-field {
      display: grid;
      min-width: 0;
      gap: 6px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 700;
    }
    .simulator-field-label {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px;
    }
    .simulator-field input,
    .simulator-field select {
      width: 100%;
      box-sizing: border-box;
      min-width: 0;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px;
      background: #fff;
      color: var(--ink);
      font: inherit;
    }
    .simulator-form button[type="submit"] {
      border: 0;
      border-radius: 8px;
      padding: 11px 18px;
      background: var(--accent);
      color: #fff;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }
    .simulator-summary {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      margin: 12px 0;
    }
    .simulator-error {
      color: #9b352b;
      font-weight: 700;
    }
    .table-scroll-hint { display: none; }
    .horse-name {
      min-width: 8em;
      white-space: nowrap;
      word-break: keep-all;
      overflow-wrap: normal;
    }
    .prediction-table { min-width: 980px; }
    .prediction-table .reason-cell {
      min-width: 300px;
      white-space: normal;
      line-height: 1.6;
    }
    .value-detail-table { min-width: 1200px; }
    .simulation-table { min-width: 680px; }
    .evaluation-table { min-width: 860px; }
    .result-table { min-width: 820px; }
    .term-with-tooltip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      white-space: nowrap;
    }
    .term-tooltip {
      display: inline-flex;
      align-items: center;
    }
    .term-tooltip .tooltip-trigger {
      display: inline-grid;
      place-items: center;
      width: 18px;
      height: 18px;
      min-width: 18px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: var(--muted);
      font: inherit;
      font-size: 13px;
      line-height: 1;
      cursor: help;
    }
    .term-tooltip .tooltip-trigger:hover,
    .term-tooltip .tooltip-trigger:focus-visible {
      color: var(--accent);
      outline: 2px solid #9bb8ae;
      outline-offset: 2px;
    }
    .tooltip-content {
      position: fixed;
      z-index: 100;
      left: 50%;
      bottom: 20px;
      width: min(440px, calc(100vw - 32px));
      box-sizing: border-box;
      padding: 12px 14px;
      border-radius: 9px;
      background: #243b36;
      color: #fff;
      box-shadow: 0 12px 32px rgba(31, 37, 32, 0.24);
      font-size: 13px;
      font-weight: 400;
      line-height: 1.6;
      text-align: left;
      white-space: normal;
      overflow-wrap: anywhere;
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, 8px);
      transition: opacity 120ms ease, transform 120ms ease, visibility 120ms ease;
    }
    .term-tooltip:hover .tooltip-content,
    .tooltip-trigger:focus-visible + .tooltip-content,
    .term-tooltip[data-open="true"] .tooltip-content {
      visibility: visible;
      opacity: 1;
      transform: translate(-50%, 0);
    }
    .ticket-tabs { margin: 12px 0 20px; }
    [data-ticket-panel][hidden] { display: none; }
    .simulation-section {
      margin-top: 32px;
    }
    .simulation-section-title {
      color: var(--accent);
      margin-bottom: 18px;
    }
    .ai-method-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0 0 16px;
      border-bottom: 1px solid var(--line);
    }
    .ai-method-tab {
      margin: 0 0 -1px;
      padding: 9px 14px;
      border: 1px solid transparent;
      border-radius: 10px 10px 0 0;
      background: transparent;
      color: var(--muted);
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }
    .ai-method-tab[aria-selected="true"] {
      border-color: var(--line);
      border-bottom-color: var(--panel);
      border-radius: 10px 10px 0 0;
      background: var(--panel);
      color: var(--accent);
    }
    .prediction-section.has-ai-tabs .prediction-method-tabs,
    .simulation-section.has-ai-tabs .simulation-method-tabs,
    .result-section.has-ai-tabs .result-method-tabs {
      position: relative;
      z-index: 2;
      align-items: flex-end;
      margin-bottom: -1px;
      border-bottom: 0;
    }
    .prediction-section.has-ai-tabs .prediction-method-tabs .ai-method-tab,
    .simulation-section.has-ai-tabs .simulation-method-tabs .ai-method-tab,
    .result-section.has-ai-tabs .result-method-tabs .ai-method-tab {
      position: relative;
      margin-bottom: 0;
      border-color: var(--line);
      background: #f4f2ed;
    }
    .prediction-section.has-ai-tabs .prediction-method-tabs .ai-method-tab[aria-selected="true"],
    .simulation-section.has-ai-tabs .simulation-method-tabs .ai-method-tab[aria-selected="true"],
    .result-section.has-ai-tabs .result-method-tabs .ai-method-tab[aria-selected="true"] {
      z-index: 3;
      border-bottom-color: var(--panel);
      background: var(--panel);
    }
    .prediction-section.has-ai-tabs .prediction-method-tabs .ai-method-tab[aria-selected="true"]::after,
    .simulation-section.has-ai-tabs .simulation-method-tabs .ai-method-tab[aria-selected="true"]::after,
    .result-section.has-ai-tabs .result-method-tabs .ai-method-tab[aria-selected="true"]::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: -2px;
      left: 0;
      height: 3px;
      background: var(--panel);
    }
    .prediction-section.has-ai-tabs .prediction-method-content,
    .simulation-section.has-ai-tabs .simulation-method-content,
    .result-section.has-ai-tabs .result-method-content {
      position: relative;
      z-index: 1;
      margin-top: 0;
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 0 14px 14px 14px;
      background: var(--panel);
    }
    .prediction-method-content > .prediction-description {
      margin-top: 0;
    }
    .simulation-method-content > .simulation-panel {
      margin-bottom: 0;
    }
    .simulation-method-content > .simulation-panel + .simulation-panel {
      margin-top: 24px;
    }
    #custom-simulator {
      margin-top: 30px;
    }
    .result-method-content > .result-panel { margin-bottom: 0; }
    .result-method-content > .result-panel + .result-panel { margin-top: 18px; }
    .result-method-content > .ticket-tabs { margin-top: 28px; }
    .ai-method-tab:focus-visible {
      outline: 2px solid #9bb8ae;
      outline-offset: 2px;
    }
    .simulation-panel h4 {
      margin: 30px 0 10px;
    }
    .simulation-panel h4.simulation-block-title {
      margin: 16px 0 8px;
    }
    .simulation-panel h4.simulation-result-title {
      margin-top: 20px;
    }
    .value-simulation-panel .simulation-details {
      margin-top: 18px;
    }
    .value-simulation-panel .simulation-details + h4 {
      margin-top: 24px;
    }
    .dutching-pairs {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
      gap: 16px 20px;
      margin-top: 16px;
    }
    .dutching-pair {
      min-width: 0;
    }
    .dutching-setting {
      color: var(--muted);
      font-size: 13px;
    }
    .dutching-setting-value,
    .dutching-result-value {
      display: block;
      margin-top: 4px;
    }
    .dutching-result {
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid #e8e1d6;
    }
    .dutching-result > strong {
      font-weight: 600;
    }
    .dutching-result-value {
      font-size: 1rem;
      font-weight: 600;
    }
    .simulation-panel h4.purchase-breakdown-title {
      margin: 22px 0 10px;
      font-size: 1rem;
    }
    .prediction-table thead th,
    .purchase-breakdown-table thead th,
    .result-table thead th {
      background: #faf8f3;
      color: var(--muted);
      font-weight: 700;
    }
    .simulation-secondary-metrics {
      margin-top: 10px;
    }
    @media (min-width: 900px) {
      .race-meta-grid {
        grid-template-columns: repeat(7, minmax(0, 1fr));
      }
      .race-meta-spacer { display: block; }
      .simulation-primary-metrics {
        grid-template-columns: repeat(5, minmax(0, 1fr));
      }
      .dutching-pairs {
        grid-template-columns: repeat(5, minmax(0, 1fr));
      }
    }
    .result-panel h4 {
      margin: 28px 0 10px;
    }
    #custom-dutching-evaluations h3 {
      margin: 28px 0 10px;
    }
    .simulation-details {
      margin-top: 24px;
    }
    .simulation-details h4 {
      margin-top: 20px;
    }
    .simulation-details summary {
      color: var(--accent);
      font-weight: 700;
      cursor: pointer;
    }
    .result-section {
      margin-top: 40px;
    }
    .result-section-title {
      margin-bottom: 18px;
    }
    .result-section .result-panel:last-child { margin-bottom: 0; }
    table tbody tr.simulation-selected { background: #fff6dc; }
    .rank-prediction-top {
      color: #8A5A00;
      font-weight: 700;
    }
    .rank-result-winner {
      color: #315b78;
      font-weight: 700;
    }
    .rank-prediction-hit {
      color: #2f6b63;
      font-weight: 700;
    }
    .result-comparison-title {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }
    .hit-badge {
      display: inline-block;
      padding: 1px 6px;
      border: 1px solid #b8d1c0;
      border-radius: 999px;
      background: #e3f0e7;
      color: #2f6b63;
      font-size: 11px;
      font-weight: 700;
    }
    .comparison-up {
      color: #2f6b63;
    }
    .comparison-neutral { color: #5f6870; }
    .comparison-down {
      color: #8a5148;
    }
    .result-table .comparison-cell { white-space: nowrap; }
    [hidden] { display: none !important; }
    @media (max-width: 640px) {
      main { padding: 20px 12px 40px; }
      .panel { padding: 15px; }
      table { font-size: 13px; }
      th, td { padding: 8px 7px; }
      .horse-name { min-width: 7.5em; }
      .table-scroll-hint {
        display: block;
        margin: 0 0 6px;
        color: var(--muted);
        font-size: 12px;
        text-align: right;
      }
      .result-section {
        margin-top: 28px;
      }
      .result-method-content > .ticket-tabs { margin-top: 24px; }
      .simulation-panel h4,
      .result-panel h4 {
        margin-top: 24px;
        margin-bottom: 8px;
      }
      #custom-dutching-evaluations h3 {
        margin-top: 24px;
        margin-bottom: 8px;
      }
      .prediction-section.has-ai-tabs .prediction-method-content,
      .simulation-section.has-ai-tabs .simulation-method-content,
      .result-section.has-ai-tabs .result-method-content {
        padding: 12px;
      }
      .simulation-method-content > .simulation-panel + .simulation-panel {
        margin-top: 20px;
      }
      #custom-simulator {
        margin-top: 24px;
      }
      .tooltip-content {
        bottom: 12px;
        width: calc(100vw - 24px);
      }
    }
{% endblock %}
{% block content %}
  <main>
    <div class="panel">
      <div class="page-badges">
        {% if model_name %}<span class="ai-badge">{{ model_name }}</span>{% endif %}
        {{ ui.status_badge(status_label, status_class) }}
      </div>
      <h1>{{ race.track }} {{ race.race_number }}R {{ race.race_name }}{% if race.class_grade %} {{ ui.grade_badge(race.class_grade) }}{% endif %}</h1>
      <h2>レース基本情報</h2>
      <div class="meta race-meta-grid">
        <div><strong>日付</strong><br>{{ race.date }}</div>
        <div><strong>発走</strong><br>{{ race.start_time or "-" }}</div>
        <div><strong>コース</strong><br>{{ race.surface or "-" }}{{ race.distance|string + "m" if race.distance else "" }}</div>
        <div><strong>馬場</strong><br>{{ (result.going if page_kind == "result" else race.going) or "-" }}</div>
        <div><strong>天候</strong><br>{{ (result.weather if page_kind == "result" else race.weather) or "-" }}</div>
        <div class="race-meta-spacer" aria-hidden="true"></div>
        <div class="race-meta-spacer" aria-hidden="true"></div>
        <div><strong>頭数</strong><br>{{ horse_count }}頭</div>
        <div><strong>条件</strong><br>{{ race_condition }}</div>
        <div><strong>負担重量</strong><br>{{ race.weight_condition or "-" }}</div>
      </div>
      <p class="small race-info-time">{% if page_kind == "result" %}結果取得日時 {{ result_fetched_at_label }}{% else %}情報時点 {{ race_info_captured_at_label }}{% endif %}</p>
      <p class="small">
        <a href="../../index.html">一覧へ戻る</a>
        {% if page_kind == "prediction" and result_page_name %} / <a href="{{ result_page_name }}">結果ページ</a>{% endif %}
        {% if page_kind == "result" %} / <a href="{{ prediction_page_name }}">予想ページ</a>{% endif %}
        {% if page_kind == "prediction" and race.source_url %} / <a href="{{ race.source_url }}">netkeiba</a>{% endif %}
      </p>
    </div>

    {% if page_kind == "prediction" %}
    <div class="panel prediction-section{% if ai_views | length > 1 %} has-ai-tabs{% endif %}">
      <h2>予想比較</h2>
      {% if ai_views | length > 1 %}
      {{ tabs.ai_method_tabs(ai_views, 'prediction', 'AI予想方式') }}
      {% endif %}
      {% for view in ai_views %}
      <div class="ai-method-panel prediction-method-content" id="prediction-{{ view.method }}" role="tabpanel" data-ai-panel data-ai-method="{{ view.method }}"{% if not loop.first %} hidden{% endif %}>
        {% if ai_views | length == 1 %}
        <h3>{{ view.label }}</h3>
        {% endif %}
        <p class="small prediction-description">{{ view.description }}</p>
        {% if view.prediction_method == "statistical" %}
        <p class="small statistical-market-note">単勝オッズ・人気は比較用表示で、統計重視予想には使用していません。</p>
        {% endif %}
        {% if view.prediction_method == "general" and used_odds_label %}
        <p class="small used-odds">使用オッズ: {{ used_odds_label }}（単勝オッズ・人気は{% if used_odds_is_official %}この時点{% else %}取得時点{% endif %}の値です{% if odds_recorded_after_start %}。<span class="odds-after-start-note">発走後に取得されたオッズスナップショットのため、厳密な発走前オッズではありません</span>{% endif %}）</p>
        {% endif %}
        {% if view.prediction %}
        {% call tables.scroll_table(true) %}
          <table class="prediction-table" data-sortable>
            <thead>
              <tr>
                {{ sortable_header("馬番", 0, "number", "ascending") }}
                {{ sortable_header("馬名", 1, "text", "ascending", "horse-name") }}
                {{ sortable_header("騎手", 2, "text", "ascending") }}
                {{ sortable_header(ui_labels.win_probability, 3, "number", "descending") }}
                {{ sortable_header(ui_labels.predicted_rank, 4, "number", "ascending") }}
                {{ sortable_header("単勝オッズ", 5, "number", "ascending") }}
                {{ sortable_header("人気", 6, "number", "ascending") }}
                <th class="reason-cell">理由</th>
              </tr>
            </thead>
            <tbody>
              {% for horse in view.horse_rows %}
              <tr>
                <td class="nowrap" data-sort-value="{{ horse.horse_number }}">{{ horse.horse_number }}</td>
                <td class="horse-name{% if horse.prediction_rank == 1 %} rank-prediction-top{% endif %}">{{ horse.horse_name }}</td>
                <td class="nowrap">{{ horse.jockey or "-" }}</td>
                <td class="nowrap" data-sort-value="{{ horse.prediction.win_probability if horse.prediction else '' }}">{% if horse.prediction %}{{ "%.1f"|format(horse.prediction.win_probability * 100) }}%{% else %}-{% endif %}</td>
                <td class="nowrap{% if horse.prediction_rank == 1 %} rank-prediction-top{% endif %}" data-sort-value="{{ horse.prediction_rank if horse.prediction_rank is not none else '' }}">{{ horse.prediction_rank ~ "位" if horse.prediction_rank is not none else "-" }}</td>
                <td class="nowrap" data-sort-value="{{ horse.win_odds if horse.win_odds is not none else '' }}">{{ horse.win_odds if horse.win_odds is not none else "-" }}</td>
                <td class="nowrap" data-sort-value="{{ horse.popularity if horse.popularity is not none else '' }}">{{ horse.popularity if horse.popularity is not none else "-" }}</td>
                <td class="reason-cell">{{ horse.prediction.reason if horse.prediction else "-" }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        {% endcall %}
        {% if view.prediction.optional_summary %}<p><strong>総括:</strong> {{ view.prediction.optional_summary }}</p>{% endif %}
        {% else %}
        <p>予想はまだ生成されていません。</p>
        {% endif %}
      </div>
      {% endfor %}
    </div>

    <section class="simulation-section{% if ai_views | length > 1 %} has-ai-tabs{% endif %}">
      <h2 class="simulation-section-title">購入シミュレーション</h2>

      {% if ai_views | length > 1 %}
      {{ tabs.ai_method_tabs(ai_views, 'simulation', '購入シミュレーションのAI予想方式') }}
      {% endif %}
      {% for view in ai_views %}
      {% set simulation_value_pre = view.value_pre %}
      {% set simulation_dutching_pre = view.dutching_pre %}
      {% set expected_value_rows = view.expected_value_rows %}
      {% set value_selection_rows = view.value_selection_rows %}
      {% set value_no_purchase_reason = view.value_no_purchase_reason %}
      {% set missing_simulation_message = "このレースでは統計重視予想の購入シミュレーションは記録されていません。" if view.prediction_method == "statistical" and view.prediction else "予想取込後に生成されます。" %}
      <div class="ai-method-panel simulation-method-content{% if ai_views | length == 1 %} panel{% endif %}" id="simulation-{{ view.method }}" role="tabpanel" data-ai-panel data-ai-method="{{ view.method }}"{% if not loop.first %} hidden{% endif %}>
      {{ tabs.ticket_tabs('purchase-' ~ view.method) }}
