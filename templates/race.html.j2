          {{ ui.settlement_summary(simulation_value_post, ui_labels) }}
          {% if simulation_value_post.total_stake != 0 %}
          <table><thead><tr><th class="nowrap">馬番</th><th class="nowrap">{{ ui_labels.purchase_amount }}</th><th class="nowrap">確定オッズ</th><th class="nowrap">判定</th>{% if value_has_refund %}<th class="nowrap refund-column">{{ ui_labels.refund_amount }}</th>{% endif %}<th class="nowrap">{{ ui_labels.return_amount }}</th></tr></thead><tbody>{% for item in simulation_value_post.selections %}{% set final_odds = final_win_odds_by_horse.get(item.horse_number) %}<tr><td class="nowrap">{{ item.horse_number }}</td><td class="nowrap">{{ item.stake }}円</td><td class="nowrap">{{ final_odds if final_odds is not none else "-" }}</td><td class="nowrap settlement-outcome" data-outcome="{{ 'refund' if item.refund|default(0) else ('hit' if item.hit else 'miss') }}">{{ '返還' if item.refund|default(0) else ('的中' if item.hit else '不的中') }}</td>{% if value_has_refund %}<td class="nowrap refund-column">{{ item.refund|default(0) }}円</td>{% endif %}<td class="nowrap">{{ item.return }}円</td></tr>{% endfor %}</tbody></table>
          {% endif %}
        </div>
        {% endif %}
        </div>
        <div id="settlement-{{ view.method }}-quinella" data-ticket-panel="quinella" role="tabpanel" hidden>
          {{ quinella_ui.panels(view, 'result', rejection_reason_text, quinella_tooltips, ui_labels) }}
        </div>
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <p class="small">本ページはAIによる確率推定と購入シミュレーションを掲載するもので、的中や利益を保証するものではありません。投票はご自身の判断で行ってください。</p>
  </main>
{% endblock %}
{% block scripts %}
<script>
{% include "scripts/race_ui.js.j2" %}
</script>
{% endblock %}
